# Supabase. URL:en är inte hemlig; service-nyckeln är, och den får ALDRIG
# skickas till webbläsaren. Ingen anon-nyckel behövs – klienten pratar bara med
# våra egna API-rutter.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signerar sessionskakan. Slumpa fram: openssl rand -hex 32
SESSION_SECRET=

# Vart ordermejlen går, och avsändaren de skickas från.
ORDER_EMAIL_TO=
ORDER_EMAIL_FROM=
