# Supabase. URL:en är inte hemlig; service-nyckeln är, och den får ALDRIG
# skickas till webbläsaren. Ingen anon-nyckel behövs – klienten pratar bara med
# våra egna API-rutter.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signerar sessionskakan. Slumpa fram: openssl rand -hex 32
SESSION_SECRET=

# Microsoft 365. En appregistrering i Entra ID med rättigheten Mail.Send
# (application, admin-godkänd). Klienthemligheten går att rulla i Entra utan att
# någon byter lösenord på en riktig postlåda – det är därför den här vägen och
# inte SMTP.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Postlådan ordermejlen skickas SOM, och innesäljs adress de går till.
# Begränsa gärna appens Mail.Send till just avsändarpostlådan med en
# application access policy i Exchange – annars får appen skicka som vem som helst.
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=
